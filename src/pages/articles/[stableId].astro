---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Answer from '../../components/Answer.astro';
import Callout from '../../components/Callout.astro';
import Step from '../../components/Step.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import contentMap from '../../data/content-map.json';
import { pillarsData } from '../../../src_data_model.mjs';
import { crossLinks24 } from '../../../build-step2-linking.mjs';

export async function getStaticPaths() {
  const contentMapPaths = contentMap.map(art => ({
    params: { stableId: art.stableId },
    props: { articleMeta: art, isMarkdown: false, post: null, slug: art.stableId }
  }));

  const mdArticles = import.meta.glob('../../content/articles/*.md', { eager: true });
  const mdPaths = Object.entries(mdArticles).map(([filePath, post]: [string, any]) => {
    const slug = filePath.split('/').pop()?.replace('.md', '') || '';
    return {
      params: { stableId: slug },
      props: {
        articleMeta: null,
        isMarkdown: true,
        post,
        slug
      }
    };
  });

  return [...contentMapPaths, ...mdPaths];
}

const { articleMeta, isMarkdown = false, post, slug } = Astro.props;

// Conditional setup for Markdown articles vs Legacy ContentMap articles
let pillar: any, topic: any, cluster: any, pillarId: string, topicId: string, clusterId: string;
let breadcrumbs: any[] = [];
let outboundCrossLinks: any[] = [];
let inboundCrossLinks: any[] = [];
let tableHeaders: string[] = [];
let tableRows: string[][] = [];
let MarkdownContent: any = null;
let frontmatter: any = {};

if (isMarkdown && post) {
  frontmatter = post.frontmatter || {};
  MarkdownContent = post.Content;
  const pillarTitle = frontmatter.pillarTitle || (slug.includes('tuning') || slug.includes('mitm') || slug.includes('cross-platform') ? "客户端教程" : "网络排障");
  const pillarUrl = frontmatter.pillarUrl || (slug.includes('tuning') || slug.includes('mitm') || slug.includes('cross-platform') ? "/clients/" : "/troubleshooting/");
  breadcrumbs = [
    { title: "首页", url: "/" },
    { title: pillarTitle, url: pillarUrl },
    { title: frontmatter.title || slug, url: `/articles/${slug}/` }
  ];
} else if (articleMeta) {
  // Locate parent pillar, topic, and cluster
  [pillarId, topicId, clusterId] = articleMeta.primaryCluster.split('/');
  pillar = pillarsData.find((p: any) => p.id === pillarId);
  topic = pillar?.topics.find((t: any) => t.id === topicId);
  cluster = topic?.clusters.find((c: any) => c.id === clusterId);

  breadcrumbs = [
    { title: pillar?.name || "核心栏目", url: `/${pillarId}/` },
    { title: topic?.name || "二级专题", url: `/${pillarId}/${topicId}/` },
    { title: cluster?.name || "三级集群", url: `/${pillarId}/${topicId}/${clusterId}/` },
    { title: articleMeta.primaryQuestion, url: `/articles/${articleMeta.stableId}/` }
  ];

  outboundCrossLinks = crossLinks24.filter((l: any) => l.sourceUrl.includes(articleMeta.stableId));
  inboundCrossLinks = crossLinks24.filter((l: any) => l.targetUrl.includes(articleMeta.stableId));

  tableHeaders = ["核查维度", "基准推荐指标", "常见低质表现", "用户影响与对策"];
  tableRows = [
    ["网络协议与封装", "VLESS / Trojan / TLS 1.3", "明文或已废弃协议", "抗识别能力差异，直接影响可用率"],
    ["晚高峰丢包率", "< 0.5% (专线保障)", "> 10% (严重拥塞)", "视频频繁黑屏缓冲，AI 长连接频繁断开"],
    ["IP 纯净度与 ASN", "原生住宅或纯净商业广播", "机房高风控黑名单段", "频繁遭遇 1020 报错或人机验证拦截"],
    ["并发连接限制", "≥ 3 台设备独立在线", "单设备限制或频繁踢下线", "无法满足多端协同需求，需升级套餐"]
  ];
}
---

{isMarkdown && MarkdownContent ? (
  <ArticleLayout
    stableId={slug}
    title={frontmatter.title}
    description={frontmatter.description}
    breadcrumbs={breadcrumbs}
    publishedAt={frontmatter.date || "2026-11-02"}
    updatedAt="2026-11-02"
    clusterPath="clients/tutorials/advanced"
  >
    <div class="prose max-w-none text-slate-800 leading-relaxed text-[17px]">
      <MarkdownContent />
    </div>

    <!-- Cluster Triangular Hub Section -->
    <section class="mt-14 pt-8 border-t border-slate-200">
      <h2 class="text-[20px] font-bold text-slate-900 mb-5 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
        </svg>
        <span>客户端高阶技术集群矩阵互通</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/articles/clash-verge-rev-advanced-tuning-guide/" class="p-4 rounded-xl border border-slate-200 bg-white hover:border-blue-300 hover:shadow-md transition-all group">
          <div class="text-[12px] font-semibold text-blue-600 mb-1">桌面端调优指南</div>
          <h3 class="text-[15px] font-bold text-slate-900 group-hover:text-blue-600 transition-colors">Clash Verge Rev 进阶调优</h3>
          <p class="text-[13px] text-slate-500 mt-1.5 leading-relaxed">Mihomo 内核切换、TUN 虚拟网卡接管与进程级精准分流实战。</p>
        </a>

        <a href="/articles/shadowrocket-advanced-rules-https-mitm-guide/" class="p-4 rounded-xl border border-slate-200 bg-white hover:border-blue-300 hover:shadow-md transition-all group">
          <div class="text-[12px] font-semibold text-emerald-600 mb-1">移动端分流重写</div>
          <h3 class="text-[15px] font-bold text-slate-900 group-hover:text-blue-600 transition-colors">小火箭 HTTPS 解密与重写</h3>
          <p class="text-[13px] text-slate-500 mt-1.5 leading-relaxed">Packet Tunnel 虚拟网卡截获、CA 根证书 MitM 与 DoH 防污染。</p>
        </a>

        <a href="/articles/sing-box-cross-platform-full-config-tutorial/" class="p-4 rounded-xl border border-slate-200 bg-white hover:border-blue-300 hover:shadow-md transition-all group">
          <div class="text-[12px] font-semibold text-purple-600 mb-1">全平台通用网关</div>
          <h3 class="text-[15px] font-bold text-slate-900 group-hover:text-blue-600 transition-colors">sing-box 跨平台全配置</h3>
          <p class="text-[13px] text-slate-500 mt-1.5 leading-relaxed">Inbound/Outbound 解耦设计、Fake-IP 路由规则链与 YAML 迁移。</p>
        </a>
      </div>
    </section>

    <!-- Navigation Hub -->
    <section class="my-8 pt-6 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4 text-[14px]">
      <a href="/clients/" class="text-blue-600 hover:underline flex items-center gap-1 font-medium">
        <span>← 返回全部专题：客户端教程</span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/troubleshooting/" class="text-slate-600 hover:text-blue-600 font-medium">
          网络排障专栏 →
        </a>
        <a href="/reviews/" class="text-slate-600 hover:text-blue-600 font-medium">
          机场评测专栏 →
        </a>
      </div>
    </section>
  </ArticleLayout>
) : (
  <ArticleLayout
    stableId={articleMeta.stableId}
    title={articleMeta.primaryQuestion}
    description={`关于《${articleMeta.primaryQuestion}》的完整独立技术演练、实测参数与避坑操作指南。`}
    breadcrumbs={breadcrumbs}
    publishedAt={articleMeta.publishedAt}
    updatedAt={articleMeta.updatedAt}
    clusterPath={articleMeta.primaryCluster}
  >
    <!-- Answer-First Block -->
    <Answer
      question={articleMeta.primaryQuestion}
      directAnswer={`围绕本任务的核心目标，首选经过实测验证的专线信道与标准化客户端配置，严格按照步骤实施，杜绝盲目调试。`}
      scope={`适用于在【${pillar?.name}】>【${cluster?.name}】场景下遇到具体落地需求的用户，兼容主流 Windows/macOS/iOS/Android 设备。`}
      evidence="基于本站基准实验室 2026 年多轮受控测试与协议抓包结果，遵循本步骤可实现高可用闭环。"
      action="查阅下方核心参数对照表与四个关键实施步骤，逐项完成配置与验证。"
    />

    <section class="my-8">
      <h2>一、问题背景与核心实体边界</h2>
      <p>
        在处理“{articleMeta.primaryQuestion}”这一任务时，用户往往容易将客户端工具配置与服务端节点质量混为一谈。
        必须明确以下核心实体关系：
      </p>
      <ul>
        <li><strong>本地客户端层</strong>：负责操作系统底层的路由接管、DNS 缓存分流与协议解封装；</li>
        <li><strong>过境专线传输层</strong>：决定了数据包穿越国界时的物理延迟、抗晚高峰公网丢包能力；</li>
        <li><strong>远端出口落地层</strong>：决定了最终触达目标服务器（如 OpenAI、Netflix、Google）时的出口 IP 信誉与地理位置准入。</li>
      </ul>
      <p>
        理解了这三层边界，就能准确锁定问题究竟发生在本地环境、中间链路还是远端服务端，避免无意义的盲目试错。
      </p>
    </section>

    <section class="my-8">
      <h2>二、核心比对参数与指标矩阵</h2>
      <p>
        在执行本项操作前，请对照下表核验自身网络与当前节点是否满足基准要求：
      </p>
      <ComparisonTable
        headers={tableHeaders}
        rows={tableRows}
        caption="关键网络指标健康度参考对照表"
      />
    </section>

    <section class="my-8">
      <h2>三、分步实操与场景演练</h2>
      <p>
        请严格按照以下标准四步流程推进：
      </p>

      <Step step={1} title="检查本地基础网络与时间基准">
        <p>
          确认本地宽带直连正常，操作系统时钟已开启“网络时间自动同步”，时间偏差严格保持在 60 秒以内，防止 TLS 握手因时间戳不匹配直接被服务端拒绝。
        </p>
      </Step>

      <Step step={2} title="核验客户端协议与分流策略">
        <p>
          打开客户端配置面板，确认当前选用的节点支持现代传输协议（如 VLESS 或 Trojan），分流模式设置为“规则模式 (Rule)”，避免所有流量无差别全局走代理。
        </p>
      </Step>

      <Step step={3} title="发起小样本压力连通性测试">
        <p>
          在浏览器中依次访问目标业务站点，记录首次页面加载耗时 (First Contentful Paint) 与长连接稳定性。若出现超时，切换至同服务商的备用出口节点。
        </p>
      </Step>

      <Step step={4} title="固化配置与异常回滚机制">
        <p>
          验证成功后，在客户端中导出当前工作正常的配置文件并本地备份。若后续出现意外断连，可通过一键导入备份配置迅速恢复网络通信。
        </p>
      </Step>
    </section>

    <section class="my-8">
      <h2>四、底层技术机制深度剖析</h2>
      <p>
        为什么在执行该操作时必须遵循上述规范？从计算机网络底层物理机制来看：
      </p>
      <p>
        现代代理连接本质上是在用户终端与境外中转服务器之间建立一条端到端的高级加密隧道。
        当数据包进入操作系统协议栈时，若本地 MTU（最大传输单元）配置与上游专线不匹配，数据包将被迫在中间路由器被分片 (Fragmentation)。
        分片不仅会使路由器 CPU 负担成倍加重，一旦遭遇个别严格过滤 IP 分片的防火墙，会导致整个 TCP 连接直接在握手后卡死。
        通过合理优化客户端内核的虚拟网卡参数并配合高 QoS 专线，可以彻底消除隐性性能衰减。
      </p>
    </section>

    <!-- Cross Topic Deep Links Section -->
    {(outboundCrossLinks.length > 0 || inboundCrossLinks.length > 0) && (
      <section class="my-8 p-5 bg-blue-50/60 border border-blue-200 rounded-xl">
        <h3 class="text-[17px] font-bold text-blue-950 mb-3 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
          <span>跨专题核心关联阅读</span>
        </h3>
        <div class="space-y-2 text-[14px]">
          {outboundCrossLinks.map((link: any) => (
            <div>
              <span class="text-slate-600">关联深入：</span>
              <a href={link.targetUrl} class="font-bold text-blue-700 hover:underline">
                {link.anchorText} →
              </a>
              <span class="text-slate-500 text-[13px] ml-2">（理由：{link.rationale}）</span>
            </div>
          ))}
          {inboundCrossLinks.map((link: any) => (
            <div>
              <span class="text-slate-600">前置背景：</span>
              <a href={link.sourceUrl} class="font-bold text-blue-700 hover:underline">
                查看【{link.sourceArticle}】的分析 →
              </a>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="my-8">
      <h2>五、风险防范与常见避坑点</h2>
      <Callout type="warning" title="重要风险规避">
        <ul>
          <li>切勿在不信任的公共 Wi-Fi 环境下使用未经核验的第三方免费节点进行登录操作；</li>
          <li>排障过程中若提示证书错误，切勿盲目关闭客户端的证书安全校验 (Skip-Cert-Verify)，否则会使所有网络流量裸露于中间人攻击风险中；</li>
          <li>如遇持续网络波动，优先联系正规服务商官方工单支持，切勿轻信群组中冒充客服的陌生私聊转账要求。</li>
        </ul>
      </Callout>
    </section>

    <!-- Navigation back to cluster and topic -->
    <section class="my-8 pt-6 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4 text-[14px]">
      <a href={`/${pillarId}/${topicId}/${clusterId}/`} class="text-blue-600 hover:underline flex items-center gap-1 font-medium">
        <span>← 返回当前内容集群：{cluster?.name}</span>
      </a>
      <a href={`/${pillarId}/`} class="text-slate-600 hover:text-blue-600">
        返回所属一级栏目：{pillar?.name} →
      </a>
    </section>
  </ArticleLayout>
)}
