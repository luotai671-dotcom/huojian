---
import BaseLayout from '../../layouts/BaseLayout.astro';
import contentMap from '../../data/content-map.json';

const totalArticles = contentMap.length;
---

<BaseLayout
  title="全部评测文章档案"
  description="小火箭测评全量 432 篇原创机场测评、套餐分析、客户端配置与技术原理文章索引。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3">
        <span>已收录文章档案</span>
        <span>•</span>
        <span>{totalArticles} 篇测评</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">全部评测与使用指南文章索引</h1>
      <p class="mt-3 text-slate-600 text-base leading-relaxed">
        涵盖 28 家机场深度实测、晚高峰表现、节点倍率核算、全平台客户端安装排障及网络底层技术原理。
      </p>
      
      <div class="mt-6 flex justify-center">
        <a href="/search/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-blue-600 text-white font-medium text-sm hover:bg-blue-700 transition-colors shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          使用关键词即时检索文章
        </a>
      </div>
    </div>

    <!-- Article Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {contentMap.map((art) => (
        <a
          href={`/articles/${art.stableId}/`}
          class="card p-5 hover:border-blue-400 hover:shadow-md transition-all flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 mb-2 font-mono">
              <span class="text-blue-600 font-semibold">{art.stableId}</span>
              <span>{art.publishDate || '2026-10'}</span>
            </div>
            <h2 class="text-base font-bold text-slate-900 mb-2 line-clamp-2 hover:text-blue-600 transition-colors">
              {art.title}
            </h2>
            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
              {art.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>阅读全文 →</span>
            <span class="text-slate-400">核验有效</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Query param compatibility script -->
  <script is:inline define:vars={{ validIds: contentMap.map(a => a.stableId) }}>
    (function() {
      try {
        var params = new URLSearchParams(window.location.search);
        var targetId = params.get('post') || params.get('id');
        if (targetId) {
          targetId = targetId.trim().toLowerCase();
          if (validIds.indexOf(targetId) !== -1) {
            var targetUrl = '/articles/' + targetId + '/';
            if (window.location.pathname !== targetUrl) {
              window.location.replace(targetUrl);
            }
          }
        }
      } catch (e) {
        // silent fallback
      }
    })();
  </script>
</BaseLayout>
