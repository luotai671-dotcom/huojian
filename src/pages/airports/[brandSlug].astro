---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialDisclosure from '../../components/CommercialDisclosure.astro';
import DataStatusBadge from '../../components/DataStatusBadge.astro';
import services from '../../data/services.json';
import tests from '../../data/tests.json';

export async function getStaticPaths() {
  return services.map(brand => ({
    params: { brandSlug: brand.id },
    props: { brand }
  }));
}

const { brand } = Astro.props;

const breadcrumbs = [
  { title: "机场大全", url: "/airports/" },
  { title: brand.name, url: `/airports/${brand.id}/` }
];

const brandTests = tests.filter(t => t.brandId === brand.id);

const brandSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": brand.name,
  "serviceType": "网络加速与国际网络连接服务",
  "url": `https://xiaohuojianvpn.biz/airports/${brand.id}/`,
  "provider": {
    "@type": "Organization",
    "name": brand.name
  },
  "offers": {
    "@type": "Offer",
    "price": brand.minPayment || "8",
    "priceCurrency": "CNY",
    "description": brand.minPaymentPlan || "入门套餐"
  }
};
---

<BaseLayout
  title={`${brand.name} 机场评测与官网档案 — 小火箭测评`}
  description={`${brand.name} 完整品牌资料档案、最新资费套餐、节点线路测试结果、优惠码与优缺点分析。`}
  canonicalUrl={`https://xiaohuojianvpn.biz/airports/${brand.id}/`}
  schema={brandSchema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Brand Profile Hero Card -->
    <header class="card my-6 border-slate-200">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-100">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="text-[30px] font-extrabold text-slate-900 tracking-tight">
              {brand.name}
            </h1>
            {brand.isPrimaryRecommendation && (
              <span class="px-2.5 py-1 rounded bg-blue-600 text-white font-bold text-[12px]">
                本站主推品牌
              </span>
            )}
            <DataStatusBadge status={brand.lineType?.dataStatus || "measured"} />
          </div>
          <p class="text-[14px] text-slate-500 mt-1">
            品牌标识：<code class="font-mono text-slate-700">{brand.id}</code> · 
            别名/英文：{brand.aliases.join(', ') || '无'} · 
            运营起始：{brand.since?.value || '待核验'} 年
          </p>
        </div>

        <div class="text-right">
          <span class="text-[13px] text-slate-400 block">入门门槛</span>
          <span class="numeric text-[24px] font-extrabold text-blue-600">
            {brand.minPayment ? `${brand.minPayment} 元/月` : '详见套餐'}
          </span>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-6 border-b border-slate-100 text-[14px]">
        <div>
          <span class="text-slate-400 block text-[12px]">线路架构</span>
          <strong class="text-slate-800 text-[15px]">{brand.lineType?.value?.join(' + ') || '待核验'}</strong>
        </div>
        <div>
          <span class="text-slate-400 block text-[12px]">核心协议</span>
          <strong class="text-slate-800 text-[15px]">{brand.protocols?.value?.join(' / ') || '待核验'}</strong>
        </div>
        <div>
          <span class="text-slate-400 block text-[12px]">节点与地区</span>
          <strong class="text-slate-800 text-[15px]">{brand.nodes?.value?.summary || '多地区覆盖'}</strong>
        </div>
        <div>
          <span class="text-slate-400 block text-[12px]">专属折扣码</span>
          <strong class="font-mono text-amber-600 text-[16px]">{brand.promoCode || '无'}</strong>
        </div>
      </div>

      <!-- CTA Register Action -->
      <div class="pt-6 flex flex-wrap items-center justify-between gap-4">
        <span class="text-[13px] text-slate-500">
          数据核验日期：{brand.dataVerifiedAt} · 商业合作透明标记
        </span>
        <div class="flex items-center gap-3">
          <a
            href={brand.registerUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="px-6 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-[15px] shadow-sm transition-all"
          >
            前往 {brand.name} 官网注册
          </a>
        </div>
      </div>
    </header>

    <CommercialDisclosure />

    <!-- Detailed Analysis Sections -->
    <article class="article-content my-8 space-y-8">
      <section>
        <h2>一、品牌定位与适用人群</h2>
        <p>{brand.comparisonNotes}</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
          <div class="p-4 bg-emerald-50/60 border border-emerald-200 rounded-xl">
            <h3 class="text-[16px] font-bold text-emerald-900 mb-2 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>推荐适用场景</span>
            </h3>
            <ul class="text-[14px] text-emerald-800 space-y-1 list-disc pl-5">
              {brand.suitableFor.map(item => <li>{item}</li>)}
            </ul>
          </div>

          <div class="p-4 bg-amber-50/60 border border-amber-200 rounded-xl">
            <h3 class="text-[16px] font-bold text-amber-900 mb-2 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <span>不适合 / 限制条件</span>
            </h3>
            <ul class="text-[14px] text-amber-800 space-y-1 list-disc pl-5">
              {brand.notSuitableFor.map(item => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      {brand.vendorClaims.length > 0 && (
        <section>
          <h2>二、服务商公开声明与承诺</h2>
          <div class="bg-purple-50/70 border border-purple-200 rounded-xl p-4 text-[14px] text-purple-900 space-y-2">
            {brand.vendorClaims.map(claim => (
              <p>• {claim.startsWith("品牌资料显示") ? claim : `品牌资料显示：${claim}`}</p>
            ))}
          </div>
          <p class="text-[13px] text-slate-500 mt-2">
            * 提示：以上内容属于服务商自行宣称资料，具体稳定性与流媒体解锁能力请参考下方实测抽样。
          </p>
        </section>
      )}

      <!-- Test Evidence Section -->
      {brandTests.length > 0 && (
        <section>
          <h2>三、本站实测抽样记录</h2>
          {brandTests.map(test => (
            <div class="my-4 p-4 border border-slate-200 rounded-xl bg-slate-50">
              <div class="flex items-center justify-between text-[13px] text-slate-500 mb-2">
                <span>测试环境：{test.environment}</span>
                <span>日期：{test.testDate}</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-3">
                {test.results.map(r => (
                  <div class="p-2 bg-white rounded border border-slate-200 text-center">
                    <span class="text-[12px] text-slate-400 block">{r.metric}</span>
                    <strong class="numeric text-[16px] text-slate-800">{r.value} {r.unit}</strong>
                  </div>
                ))}
              </div>
              <p class="text-[13px] text-slate-600 mt-2">实测说明：{test.notes}</p>
            </div>
          ))}
        </section>
      )}

      <!-- Internal links to other hubs -->
      <section class="pt-6 border-t border-slate-200">
        <h2>四、相关选型栏目指引</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 my-4">
          <a href="/recommend/" class="p-3 border border-slate-200 rounded-lg hover:border-blue-400 block text-center">
            <strong class="block text-[15px] text-slate-800">机场推荐榜单</strong>
            <span class="text-[12px] text-slate-500">查看横向对比</span>
          </a>
          <a href="/plans/" class="p-3 border border-slate-200 rounded-lg hover:border-blue-400 block text-center">
            <strong class="block text-[15px] text-slate-800">套餐资费对比</strong>
            <span class="text-[12px] text-slate-500">计算每GB真实成本</span>
          </a>
          <a href="/reviews/" class="p-3 border border-slate-200 rounded-lg hover:border-blue-400 block text-center">
            <strong class="block text-[15px] text-slate-800">测试方法与证据</strong>
            <span class="text-[12px] text-slate-500">查看晚高峰测速标准</span>
          </a>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
