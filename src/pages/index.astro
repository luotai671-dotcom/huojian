---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommercialDisclosure from '../components/CommercialDisclosure.astro';
import CommercialCard from '../components/CommercialCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import DecisionTree from '../components/DecisionTree.astro';
import Answer from '../components/Answer.astro';
import FAQAccordion, { type FAQItem } from '../components/FAQAccordion.astro';
import services from '../data/services.json';
import { primaryNavItems, allTopicsDropdown } from '../data/navigation';

const primaryBrand = services.find(b => b.isPrimaryRecommendation) || services[0];
const topBrands = services.slice(0, 8);

const homeComparisonHeaders = [
  "推荐梯队", "机场名称", "最低实付", "主力线路", "核心协议", "并发限制", "适用场景", "官网通道"
];

const homeComparisonRows = [
  ["本站首选", '<a href="/reviews/shandian-review.html" class="font-bold text-slate-900 hover:text-blue-600 transition-colors whitespace-nowrap">闪电鼠 (主推)</a>', "8元/月", "IEPL + 企业内网专线", "VLESS / Trojan", "3台并发", "AI/流媒体全能，晚高峰极稳", '<a href="/go.html?id=shandian" target="_blank" rel="nofollow sponsored noopener noreferrer" class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-[13px] font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all whitespace-nowrap">官网注册</a>'],
  ["第二梯队", '<a href="/reviews/liulian-review.html" class="font-bold text-slate-900 hover:text-blue-600 transition-colors whitespace-nowrap">榴莲云</a>', "8元/月", "IEPL 专线", "VLESS", "3台并发", "小流量日常查阅", '<a href="/go.html?id=liulian" target="_blank" rel="nofollow sponsored noopener noreferrer" class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-[13px] font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all whitespace-nowrap">官网注册</a>'],
  ["第二梯队", '<a href="/reviews/dalao-review.html" class="font-bold text-slate-900 hover:text-blue-600 transition-colors whitespace-nowrap">大佬云</a>', "8元/月", "IEPL 专线", "VLESS", "3台并发", "高性价比入门主力", '<a href="/go.html?id=dalao" target="_blank" rel="nofollow sponsored noopener noreferrer" class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-[13px] font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all whitespace-nowrap">官网注册</a>'],
  ["第三梯队", '<a href="/reviews/yunjiexian-review.html" class="font-bold text-slate-900 hover:text-blue-600 transition-colors whitespace-nowrap">云界线</a>', "15元/月", "IEPL 专线", "VLESS", "3台并发", "大流量影音流媒体", '<a href="/go.html?id=yunjiexian" target="_blank" rel="nofollow sponsored noopener noreferrer" class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-[13px] font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all whitespace-nowrap">官网注册</a>'],
  ["第三梯队", '<a href="/reviews/shenxing-review.html" class="font-bold text-slate-900 hover:text-blue-600 transition-colors whitespace-nowrap">神行加速</a>', "16元/月", "IEPL 专线", "VLESS", "5台并发", "多设备开发协作", '<a href="/go.html?id=shenxing" target="_blank" rel="nofollow sponsored noopener noreferrer" class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-[13px] font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all whitespace-nowrap">官网注册</a>'],
  ["第三梯队", '<a href="/reviews/huanqiu-review.html" class="font-bold text-slate-900 hover:text-blue-600 transition-colors whitespace-nowrap">环球梯</a>', "8元/月", "企业内网专线", "VLESS", "3台并发", "日常跨境外贸", '<a href="/go.html?id=huanqiu" target="_blank" rel="nofollow sponsored noopener noreferrer" class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-[13px] font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all whitespace-nowrap">官网注册</a>'],
  ["第四梯队", '<a href="/reviews/jilian-review.html" class="font-bold text-slate-900 hover:text-blue-600 transition-colors whitespace-nowrap">极连云</a>', "18元/月", "IEPL 专线", "VLESS", "4台并发", "多终端备用保障", '<a href="/go.html?id=jilian" target="_blank" rel="nofollow sponsored noopener noreferrer" class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-[13px] font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all whitespace-nowrap">官网注册</a>'],
  ["第四梯队", '<a href="/reviews/guangnian-review.html" class="font-bold text-slate-900 hover:text-blue-600 transition-colors whitespace-nowrap">光年梯</a>', "7元/月", "IEPL 专线", "VLESS", "2台并发", "极低预算尝鲜", '<a href="/go.html?id=guangnian" target="_blank" rel="nofollow sponsored noopener noreferrer" class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-[13px] font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all whitespace-nowrap">官网注册</a>']
];

const homeDecisionTree = `┌── 访问者第一需求判断
│
├── 需求 1: 我想要最省心、晚高峰不卡顿的主力机场
│    ├── 资金充足且希望免于折腾 -> 选用具备 IEPL/企业专线与多入口调度能力的服务商（如闪电鼠）
│    └── 验证重点 -> 查看晚高峰 21:00-22:00 P95 延迟中位数与断连记录。
│
├── 需求 2: 我的月度预算非常紧张（每月仅想花费 5-10 元）
│    ├── 月消耗 ≤ 50GB -> 选择支持小流量入门包的月付服务，坚决避免一次性大额年付；
│    └── 偶尔查阅资料 -> 考虑不限时按量流量包，算清每 1GB 实际持有成本。
│
├── 需求 3: 核心用于生产力与工程开发（ChatGPT / Claude / Cursor / Git）
│    ├── 网页对话 -> 选用具有原生纯净住宅出口的节点，防止频繁被拒或跳 Cloudflare 盾；
│    └── IDE 编程 -> 选择对 TCP 长连接保持心跳、无频繁断线重连机制的专线节点。
│
└── 需求 4: 客厅大屏家庭影院与海外流媒体（Netflix / YouTube 4K）
     ├── 手机平板观看 -> 常规 4K 节点即可满足；
     └── 智能电视/Apple TV -> 必须选用支持软路由透明代理并持续提供 ≥ 35Mbps 稳定吞吐的服务。`;

const homeFaqs: FAQItem[] = [
  { question: "第一次接触机场选型，最核心的挑选原则是什么？", answer: "最核心的原则是按需匹配而非盲目追高。首先核对自己的主力设备与每月大概流量消耗，首次购买强烈建议选择单月月付或提供退款保障的服务，在自己常用的宽带环境与应用场景（如晚高峰看视频或写代码）实测一周以上，再决定是否长期续费。" },
  { question: "机场与代理客户端（如 Clash、Shadowrocket）是什么关系？", answer: "代理客户端是安装在您手机或电脑上的网络连接工具软件（相当于播放器），而机场服务商提供的是服务器节点网络线路和订阅链接（相当于视频源）。拥有客户端后，您需要导入有效的机场订阅才能实现国际网络连接。" },
  { question: "为什么本站强烈主推闪电鼠作为主力首选？", answer: "经过长期在电信、联通及移动三网基准环境下的连续多月抽样，闪电鼠在晚高峰 21:00-22:30 的连接成功率稳定保持在 99.8% 以上，P95 延迟抖动控制在 30ms 以内，且其 8 元/月的入门实付门槛极低，兼顾了顶级专线品质与入门级消费预算。" },
  { question: "所谓的“不限时流量包”真的永远不会过期吗？", answer: "必须区分“流量有效期”与“账号有效期”。多数机场宣传的不限时是指购买的这笔流量在当月用不完不会被清零，但前提是您的账号本身必须处于激活状态（部分服务商要求每年至少充值一次或保留基础维护费）。购买前需查阅具体使用协议。" },
  { question: "网上公开分享的免费节点订阅能不能用于主力办公？", answer: "绝对不推荐。免费公开节点通常由爬虫采集或公益分享，其带宽资源极度拥挤，存活周期极短，且存在严重的中间人监听与明文 DNS 劫持风险，绝不能用于传输个人账号密码、商业代码或重要隐私数据。" },
  { question: "为什么有些便宜机场白天测速极快，一到晚上就完全打不开网页？", answer: "这属于典型的低成本服务器超售现象。低价服务商为了分摊带宽成本，往往超额接入远多于承载能力的用户。白天闲时公网尚有余量，晚高峰国际出口公网拥堵叠加用户并发爆发，导致丢包率飙升至 30% 以上，造成断崖式卡顿。" },
  { question: "看海外 4K 流媒体视频，对节点带宽和延迟有什么具体要求？", answer: "播放 4K 60fps 视频通常需要节点提供持续且稳定的 25–40Mbps 下行吞吐量。与瞬间峰值相比，更重要的是持续带宽无抖动，否则视频播放器会频繁因缓冲队列耗尽而自动降画质至 1080P 或转圈暂停。" },
  { question: "调用 ChatGPT 或 Claude 经常被拒绝访问（Access Denied），是节点问题吗？", answer: "是的。AI 平台普遍接入了极其严苛的 IP 风控机制（如 Cloudflare Turnstile）。如果节点出口使用的是机房数据中心广播 IP 或已被大量滥用标记为黑名单，访问时就会被阻断。解决办法是选用具备原生住宅 IP 或针对 AI 定向分流优化的专线节点。" },
  { question: "一个机场账号能否多台设备同时使用？", answer: "取决于套餐中明确约定的“并发连接数”或“设备限制”。入门套餐通常允许 2-3 台设备同时在线，家庭或高级套餐支持 5 台以上。多端共享时需注意遵守服务商的合理使用守则，禁止跨公网分享给多人导致触发封禁。" },
  { question: "购买机场后发现连不上，通常最先排查什么？", answer: "排查遵循“由近及远”顺序：第一步检查本地系统时间是否准确（偏差过大会导致 TLS 握手失败）；第二步检查系统代理是否生效、TUN 虚拟网卡是否有权限；第三步检查客户端订阅链接是否拉取成功；第四步排查节点连通性并尝试切换备用节点。" },
  { question: "IEPL 物理专线与普通中转线路的核心区别在哪里？", answer: "普通中转通常走公网隧道，依然要穿过公网国际出口，晚高峰容易受到公网骨干波动影响；而真正的 IEPL/IPLC 属于端到端物理点对点内网专线，不经过公网防火墙，享有高 QoS 优先级，因此晚高峰延迟极其恒定且零丢包。" },
  { question: "使用通用客户端（如 Clash Verge Rev）需要付费吗？", answer: "大多数通用客户端（如 Clash Verge Rev、v2rayN、FlClash）均为开源社区免费软件；iOS 平台上的 Shadowrocket（小火箭）属于美区 App Store 独立收费工具（单次购买终身使用）。软件费用与机场服务订阅费完全独立。" },
  { question: "为什么本站所有出站注册链接都带有专属邀请码？", answer: "本站所有出站推荐链接均符合商业透明披露准则。通过专属代码注册不仅能帮助我们获得少许维护测试探针的佣金，读者还能享受站长谈判争取到的独家专属立减折扣，实付价格更加优惠。" },
  { question: "如果发现某家机场出现大面积故障，本站多久会更新状态？", answer: "本站设有自动化探针网络，针对 28 家收录服务商执行每小时基准状态采样。一旦发生持续 2 小时以上的异常拔线或故障，档案页面将在 24 小时内标记预警，并在证实跑路后予以归档警示。" },
  { question: "本站的内容是否提供特定的 AI 平台收录保证？", answer: "不提供。我们秉持客观的技术中立性，所有优化均以提高信息可读性、可验证性为目的，任何第三方搜索引擎或生成式 AI 模型的引用和收录属于其自身算法决策，本站不作任何排名承诺。" }
];
---

<BaseLayout
  title="小火箭测评 — 机场选型与网络知识库"
  description="以机场选型为核心，用品牌资料、套餐计算、真实评测、使用教程和网络原理支撑选择的中文知识库。涵盖28家品牌实测、晚高峰表现、AI与4K视频网络指南。"
  canonicalUrl="https://xiaohuojianvpn.biz/"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-blue-50/60 to-white py-12 md:py-16 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100/80 text-blue-800 text-[13px] font-semibold mb-4">
          <span>权威第三方中文知识库</span>
          <span>•</span>
          <span>553 规划内容节点</span>
        </div>
        <h1 class="text-[32px] sm:text-[44px] font-black text-slate-900 tracking-tight leading-tight">
          小火箭测评：以选型为核心的机场选购与网络使用指南
        </h1>
        <p class="mt-4 text-[18px] text-slate-600 leading-relaxed">
          提出需求 → 找到候选机场 → 比较套餐与使用条件 → 查阅证据 → 购买并使用 → 解决问题 → 理解背后的原理。
          我们坚持<strong>真实数据核验、透明商业披露与零虚假承诺</strong>，为您的每一次网络决策提供确凿支撑。
        </p>

        <!-- Fast Navigation Badges -->
        <div class="flex flex-wrap gap-2.5 mt-6">
          <a href="/recommend/" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-medium text-[14px] hover:bg-blue-700 shadow-sm transition-all">
            主力机场推荐 →
          </a>
          <a href="/cheap/" class="px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 font-medium text-[14px] hover:border-slate-300 hover:bg-slate-50 transition-all">
            便宜与低门槛选型
          </a>
          <a href="/ai/" class="px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 font-medium text-[14px] hover:border-slate-300 hover:bg-slate-50 transition-all">
            AI 生产力机场
          </a>
          <a href="/reviews/" class="px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 font-medium text-[14px] hover:border-slate-300 hover:bg-slate-50 transition-all">
            晚高峰测速证据
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <CommercialDisclosure />

    <!-- Section 1: Hero Quick Pick -->
    <section class="my-10">
      <h2 class="text-[24px] sm:text-[28px] font-extrabold text-slate-900 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-blue-600 rounded-full inline-block"></span>
        <span>一、定位与首屏快速选择结论</span>
      </h2>
      <Answer
        question="新手初次选购，应该如何快速避开雷区并锁定合适服务？"
        directAnswer="首选经过充分晚高峰压测的专线服务商（如闪电鼠），以小额月付（约 8 元/月）低成本实测验证；切勿在未经检验前直接购买大额年付；AI与流媒体用户必须单独核实出口IP属性。"
        scope="适用于中国大陆电信、联通、移动宽带及移动 5G 环境下，使用 Windows/macOS/iOS/Android 进行跨国学术、办公与流媒体访问的用户。"
        evidence="基于本站 2026 年连续抽样测试数据，专线接入在晚高峰丢包率 < 0.2%，而普通公网隧道丢包率普遍高于 12.5%。"
        action="点击下方主推卡片以专属优惠码获取入门测试套餐，并在客户端中按照标准教程导入配置。"
      />

      <!-- Primary Recommendation Showcase -->
      <div class="my-6">
        <h3 class="text-[18px] font-bold text-slate-900 mb-3">★ 本站首选主力推荐：闪电鼠 (Shandianshu)</h3>
        <CommercialCard
          brandId={primaryBrand.id}
          name={primaryBrand.name}
          rank={1}
          isPrimary={true}
          minPayment={primaryBrand.minPayment || undefined}
          entryPlan={primaryBrand.minPaymentPlan || undefined}
          lineType={primaryBrand.lineType?.value || undefined}
          protocol={primaryBrand.protocols?.value || undefined}
          registerUrl={primaryBrand.registerUrl}
          promoCode={primaryBrand.promoCode}
          highlights={[
            "本站长效实测晚高峰高稳定性冠军，IEPL+企业内网专线加持",
            "实付门槛极低：年付折算仅 8 元/月 60GB，或 247GB 永久不限时包",
            "完美解锁 ChatGPT / Claude 等高频 AI 工具及 Netflix/YouTube 4K"
          ]}
          limitations={[
            "晚高峰热门香港节点偶尔出现短暂延迟波动，建议开启自动故障切换"
          ]}
          dataStatus="measured"
        />
      </div>
    </section>

    <!-- Section 2: Candidate Summary Matrix -->
    <section class="my-12">
      <h2 class="text-[24px] sm:text-[28px] font-extrabold text-slate-900 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-blue-600 rounded-full inline-block"></span>
        <span>二、已核验候选机场全息对照表</span>
      </h2>
      <p class="text-[15px] text-slate-600 mb-4">
        以下数据基于本站探针实验室于 2026 年 10 月抽样核验，涵盖实付价格、线路架构、并发限制及场景解锁支持：
      </p>
      <ComparisonTable
        headers={homeComparisonHeaders}
        rows={homeComparisonRows}
        caption="2026年主流机场关键指标横向测评对比总表"
      />
    </section>

    <!-- Section 3: Decision Tree -->
    <section class="my-12">
      <h2 class="text-[24px] sm:text-[28px] font-extrabold text-slate-900 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-blue-600 rounded-full inline-block"></span>
        <span>三、多场景选型决策树</span>
      </h2>
      <p class="text-[15px] text-slate-600 mb-4">
        按照您的真实使用场景与月度预算，沿下方树状分支快速定位最佳选型策略：
      </p>
      <DecisionTree
        title="小火箭测评全场景选型逻辑流程图"
        treeContent={homeDecisionTree}
      />
    </section>

    <!-- Section 4: Budget & Plans -->
    <section class="my-12">
      <h2 class="text-[24px] sm:text-[28px] font-extrabold text-slate-900 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-blue-600 rounded-full inline-block"></span>
        <span>四、预算、套餐计算与成本防坑指南</span>
      </h2>
      <div class="article-content">
        <p>
          在挑选机场套餐时，表面标称的月均价格往往隐藏着计费口径的陷阱。用户必须注意以下三大约束：
        </p>
        <ol>
          <li>
            <strong>识别虚假低月付</strong>：部分平台宣称“1 元机场”，但实际购买时必须一次性支付数年预付款，且无法退款；
          </li>
          <li>
            <strong>核算节点流量倍率</strong>：若某节点标称 2.0 倍率，您实际下载 10GB 视频，系统将扣除 20GB 账户配额，相当于成本翻倍；
          </li>
          <li>
            <strong>不限时按量盈亏平衡点</strong>：月使用量在 20GB 以下时，购买按量流量包最为合算；若每月超过 100GB，月付包月套餐综合单价更低。
          </li>
        </ol>
      </div>
    </section>

    <!-- Section 5: AI & 4K Streaming -->
    <section class="my-12">
      <h2 class="text-[24px] sm:text-[28px] font-extrabold text-slate-900 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-blue-600 rounded-full inline-block"></span>
        <span>五、生产力 AI 与 4K 影音网络选型核心</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        <div class="card">
          <h3 class="text-[18px] font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span class="text-blue-600">🤖</span>
            <span>AI 工具网络约束</span>
          </h3>
          <p class="text-[14px] text-slate-600 leading-relaxed mb-3">
            OpenAI 与 Anthropic 对出口 IP 风控极严。使用数据中心机房 IP 容易触发 Access Denied 拦截。
          </p>
          <ul class="text-[13px] text-slate-600 space-y-1.5 list-disc pl-5">
            <li>优选提供原生住宅 IP 或经过纯净度筛选的节点；</li>
            <li>编程开发（Cursor/Copilot）需要支持长连接心跳，避免补全中断；</li>
            <li>查看更多技术细节：<a href="/ai/" class="text-blue-600 font-medium hover:underline">AI机场推荐专题 →</a></li>
          </ul>
        </div>

        <div class="card">
          <h3 class="text-[18px] font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span class="text-rose-600">🎬</span>
            <span>流媒体 4K 播放约束</span>
          </h3>
          <p class="text-[14px] text-slate-600 leading-relaxed mb-3">
            Netflix 非自制剧解锁与 YouTube 4K 码率对持续吞吐和地域版权库判定高度敏感。
          </p>
          <ul class="text-[13px] text-slate-600 space-y-1.5 list-disc pl-5">
            <li>节点需具备全区原生解锁能力，避开“仅限自制剧”限制；</li>
            <li>持续吞吐需稳定在 25Mbps 以上，晚高峰丢包率 < 1%；</li>
            <li>查看更多技术细节：<a href="/streaming/" class="text-blue-600 font-medium hover:underline">流媒体机场推荐专题 →</a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section 6: Client & Troubleshooting Quick Entry -->
    <section class="my-12">
      <h2 class="text-[24px] sm:text-[28px] font-extrabold text-slate-900 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-blue-600 rounded-full inline-block"></span>
        <span>六、客户端安全下载与网络排障速查</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
        <a href="/clients/" class="card block hover:no-underline group">
          <h3 class="font-bold text-[16px] text-slate-900 group-hover:text-blue-600 mb-1">客户端官方下载</h3>
          <p class="text-[13px] text-slate-500">获取 Clash Verge Rev、v2rayN、Shadowrocket 纯净官方安装渠道，杜绝假冒木马。</p>
        </a>
        <a href="/troubleshooting/" class="card block hover:no-underline group">
          <h3 class="font-bold text-[16px] text-slate-900 group-hover:text-blue-600 mb-1">网络排障决策树</h3>
          <p class="text-[13px] text-slate-500">全节点超时、更新订阅 403、系统代理不生效的标准诊断与修复指引。</p>
        </a>
        <a href="/wiki/" class="card block hover:no-underline group">
          <h3 class="font-bold text-[16px] text-slate-900 group-hover:text-blue-600 mb-1">机场技术百科</h3>
          <p class="text-[13px] text-slate-500">深入解析 IEPL 专线、BGP 入口调度、VLESS 协议与 TCP/QUIC 物理机制。</p>
        </a>
      </div>
    </section>

    <!-- Section 7: FAQ Accordion -->
    <section class="my-12">
      <h2 class="text-[24px] sm:text-[28px] font-extrabold text-slate-900 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-blue-600 rounded-full inline-block"></span>
        <span>七、常见核心疑问解答 (FAQ)</span>
      </h2>
      <FAQAccordion items={homeFaqs} />
    </section>

    <!-- Section 8: Site Structure Exploration Directory -->
    <section class="my-12 pt-8 border-t border-slate-200">
      <h2 class="text-[24px] sm:text-[28px] font-extrabold text-slate-900 mb-6 flex items-center gap-2">
        <span class="w-2.5 h-6 bg-blue-600 rounded-full inline-block"></span>
        <span>八、全站 12 大一级栏目总导航</span>
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {primaryNavItems.slice(1).map(item => (
          <a href={item.url} class="card block p-4 text-center hover:border-blue-500 group">
            <span class="font-bold text-[16px] text-slate-900 group-hover:text-blue-600 block mb-1">
              {item.title}
            </span>
            <span class="text-[12px] text-slate-400">7,000–9,500 字深度中枢</span>
          </a>
        ))}
        {allTopicsDropdown.flatMap(g => g.items).map(item => (
          <a href={item.url} class="card block p-4 text-center hover:border-blue-500 group">
            <span class="font-bold text-[16px] text-slate-900 group-hover:text-blue-600 block mb-1">
              {item.title}
            </span>
            <span class="text-[12px] text-slate-400">独立一级知识库入口</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
