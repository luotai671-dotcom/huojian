---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogType = "website",
  schema,
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteName = "小火箭测评";
const fullTitle = title.includes(siteName) ? title : `${title} — ${siteName}`;

const defaultWebSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": "https://xiaohuojianvpn.biz",
  "description": "以机场选型为核心，用品牌资料、套餐计算、真实评测、使用教程和网络原理支撑选择的中文知识库",
  "inLanguage": "zh-CN"
};

const schemasToRender = schema 
  ? (Array.isArray(schema) ? [defaultWebSiteSchema, ...schema] : [defaultWebSiteSchema, schema])
  : [defaultWebSiteSchema];
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="zh_CN" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

  <!-- Twitter Meta -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />

  <!-- Preconnect to Google Fonts if needed -->
  <meta name="format-detection" content="telephone=no" />

  <!-- JSON-LD Structured Data -->
  {schemasToRender.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <!-- Fallback critical CSS for SVG sizing -->
  <style is:inline>
    svg { max-width: 100%; }
    .logo-svg { width: 32px !important; height: 32px !important; max-width: 32px !important; max-height: 32px !important; flex-shrink: 0 !important; }
  </style>

  <script is:inline>
    if (window.location.protocol === 'file:') {
      (function() {
        var p = window.location.pathname.replace(/\\/g, '/');
        // If opened from project root directly, forward to dist/index.html
        if (!p.includes('/dist/')) {
          window.location.replace('./dist/index.html' + window.location.search + window.location.hash);
          return;
        }

        var distIdx = p.indexOf('/dist/');
        var distBase = p.substring(0, distIdx + 6); // ends with '/dist/'

        // Handle root-relative links gracefully without alerts or broken paths
        document.addEventListener('click', function(e) {
          var a = e.target.closest('a');
          if (!a) return;
          var href = a.getAttribute('href');
          if (!href) return;

          // Allow external links, hash anchors, mailto, tel, javascript to behave normally
          if (href.startsWith('#') || href.startsWith('http://') || href.startsWith('https://') ||
              href.startsWith('//') || href.startsWith('mailto:') || href.startsWith('tel:') ||
              href.startsWith('javascript:')) {
            return;
          }

          // Route root-relative links to local static html files
          if (href.startsWith('/')) {
            e.preventDefault();
            var clean = href.replace(/^\/+/, '');
            var hash = '';
            var hashIdx = clean.indexOf('#');
            if (hashIdx !== -1) {
              hash = clean.slice(hashIdx);
              clean = clean.slice(0, hashIdx);
            }
            var query = '';
            var queryIdx = clean.indexOf('?');
            if (queryIdx !== -1) {
              query = clean.slice(queryIdx);
              clean = clean.slice(0, queryIdx);
            }

            var target;
            if (!clean) {
              target = 'index.html';
            } else if (clean.endsWith('.html') || clean.endsWith('.xml') || clean.endsWith('.txt') || clean.endsWith('.svg') || clean.endsWith('.png')) {
              target = clean;
            } else {
              target = clean.replace(/\/+$/, '') + '/index.html';
            }

            window.location.href = 'file://' + distBase + target + query + hash;
          }
        }, true);
      })();
    }
  </script>
</head>

