---
export interface BreadcrumbItem {
  title: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

// Ensure Home is always first
const fullItems: BreadcrumbItem[] = [
  { title: "首页", url: "/" },
  ...items
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": fullItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.title,
    "item": `https://xiaohuojianvpn.biz${item.url}`
  }))
};
---

<nav aria-label="面包屑导航" class="my-4 text-[13px] text-slate-500 overflow-x-auto whitespace-nowrap py-1">
  <ol class="flex items-center gap-1.5 list-none p-0 m-0">
    {fullItems.map((item, idx) => {
      const isLast = idx === fullItems.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {idx > 0 && (
            <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
          {isLast ? (
            <span class="font-medium text-slate-800" aria-current="page">
              {item.title}
            </span>
          ) : (
            <a href={item.url} class="text-slate-600 hover:text-blue-600 transition-colors">
              {item.title}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
