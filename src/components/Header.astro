---
import { primaryNavItems } from '../data/navigation';
import AllTopicsDropdown from './AllTopicsDropdown.astro';
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <!-- Top compliance disclaimer bar -->
  <div class="bg-slate-50 border-b border-slate-100 py-1 px-4 text-center text-[12px] text-slate-500">
    <span>本站为独立的第三方机场选购与使用指南知识库，与任何机场品牌或代理软件官方无隶属关系。</span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo and branding -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 text-slate-900 hover:text-blue-600 transition-colors">
          <svg class="w-8 h-8 text-blue-600 logo-svg" width="32" height="32" style="width: 32px; height: 32px; max-width: 32px; max-height: 32px; flex-shrink: 0;" viewBox="0 0 64 64" fill="none">
            <rect width="64" height="64" rx="16" fill="#2563EB"/>
            <path d="M48 16L34 30M48 16C42 16 32 20 26 26C20 32 16 42 16 48C22 48 32 44 38 38C44 32 48 22 48 16Z" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M22 42L16 48L22 48L22 42Z" fill="#FACC15"/>
            <path d="M25 25L39 39" stroke="#93C5FD" stroke-width="3" stroke-linecap="round"/>
          </svg>
          <span class="font-bold text-[19px] tracking-tight text-slate-900">小火箭测评</span>
        </a>
      </div>

      <!-- Desktop Navigation (7 primary + dropdown) -->
      <nav class="hidden lg:flex items-center gap-6" aria-label="主导航">
        {primaryNavItems.map((item) => (
          <a
            href={item.url}
            class="text-[15px] font-medium text-slate-700 hover:text-blue-600 transition-colors"
          >
            {item.title}
          </a>
        ))}
        <AllTopicsDropdown />
      </nav>

      <!-- Right utility actions (Search + Mobile toggle) -->
      <div class="flex items-center gap-3">
        <a
          href="/search/"
          class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 text-[14px] transition-colors"
          title="搜索全站知识库"
          id="header-search-btn"
        >
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span class="hidden sm:inline">搜索...</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          class="lg:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100"
          id="mobile-menu-toggle"
          aria-label="打开移动端导航菜单"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-2">
    <div class="grid grid-cols-2 gap-2 pt-2 pb-3 border-b border-slate-100">
      {primaryNavItems.map((item) => (
        <a
          href={item.url}
          class="block px-3 py-2 rounded-md text-[15px] font-medium text-slate-700 hover:bg-blue-50 hover:text-blue-600"
        >
          {item.title}
        </a>
      ))}
    </div>
    <div class="pt-2">
      <div class="px-2 py-1 text-[12px] font-semibold text-slate-400 uppercase tracking-wider">全部专题</div>
      <div class="grid grid-cols-2 gap-1 mt-1">
        <a href="/plans/" class="px-3 py-1.5 text-[14px] text-slate-600 hover:text-blue-600">套餐对比</a>
        <a href="/ai/" class="px-3 py-1.5 text-[14px] text-slate-600 hover:text-blue-600">AI工具</a>
        <a href="/streaming/" class="px-3 py-1.5 text-[14px] text-slate-600 hover:text-blue-600">流媒体机场</a>
        <a href="/clients/" class="px-3 py-1.5 text-[14px] text-slate-600 hover:text-blue-600">客户端教程</a>
        <a href="/troubleshooting/" class="px-3 py-1.5 text-[14px] text-slate-600 hover:text-blue-600">网络排障</a>
        <a href="/wiki/" class="px-3 py-1.5 text-[14px] text-slate-600 hover:text-blue-600">机场百科</a>
        <a href="/airports/" class="px-3 py-1.5 text-[14px] text-slate-600 hover:text-blue-600 col-span-2">机场大全</a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
