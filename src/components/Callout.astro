---
interface Props {
  type?: "info" | "warning" | "success" | "danger";
  title?: string;
}

const { type = "info", title } = Astro.props;

let borderClass = "border-blue-500 bg-blue-50/70 text-blue-900";
let iconColor = "text-blue-600";

if (type === "warning") {
  borderClass = "border-amber-500 bg-amber-50/70 text-amber-900";
  iconColor = "text-amber-600";
} else if (type === "success") {
  borderClass = "border-emerald-500 bg-emerald-50/70 text-emerald-900";
  iconColor = "text-emerald-600";
} else if (type === "danger") {
  borderClass = "border-rose-500 bg-rose-50/70 text-rose-900";
  iconColor = "text-rose-600";
}
---

<div class={`my-5 p-4 rounded-xl border-l-4 ${borderClass} shadow-xs`}>
  {title && (
    <div class="font-bold text-[16px] mb-1.5 flex items-center gap-2">
      <svg class={`w-5 h-5 ${iconColor} flex-shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{title}</span>
    </div>
  )}
  <div class="text-[15px] leading-relaxed">
    <slot />
  </div>
</div>
