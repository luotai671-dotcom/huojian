---
interface Props {
  step: number;
  title: string;
}

const { step, title } = Astro.props;
---

<div class="my-6 pl-10 relative">
  <div class="absolute left-0 top-0.5 w-7 h-7 rounded-full bg-blue-600 text-white font-bold text-[14px] flex items-center justify-center shadow-xs">
    {step}
  </div>
  <h4 class="text-[17px] font-bold text-slate-900 mb-2">
    {title}
  </h4>
  <div class="text-[15px] text-slate-600 leading-relaxed">
    <slot />
  </div>
</div>
