---
interface Props {
  status: "vendor" | "measured" | "unverified" | string;
  label?: string;
}

const { status, label } = Astro.props;

let badgeText = label;
let badgeClass = "bg-slate-100 text-slate-700 border-slate-200";

if (status === "vendor") {
  badgeText = badgeText || "品牌资料显示";
  badgeClass = "bg-purple-50 text-purple-700 border-purple-200";
} else if (status === "measured") {
  badgeText = badgeText || "实测已核验";
  badgeClass = "bg-blue-50 text-blue-700 border-blue-200";
} else if (status === "unverified") {
  badgeText = badgeText || "待核验";
  badgeClass = "bg-amber-50 text-amber-700 border-amber-200";
}
---

<span class={`inline-flex items-center px-2 py-0.5 rounded text-[12px] font-medium border ${badgeClass}`}>
  {badgeText}
</span>
