---
interface Props {
  headers: string[];
  rows: Array<Array<string | number | boolean>>;
  caption?: string;
}

const { headers, rows, caption } = Astro.props;
---

<div class="table-wrapper">
  <table class="data-table">
    {caption && <caption class="text-left font-semibold text-[15px] p-3 text-slate-800 bg-slate-50 border-b border-slate-200">{caption}</caption>}
    <thead>
      <tr>
        {headers.map((h) => (
          <th>{h}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, idx) => {
            const isNum = typeof cell === 'number' || (typeof cell === 'string' && /^[0-9]+(\.[0-9]+)?(ms|Mbps|GB|元|%|\/月)?$/.test(cell.trim()));
            const isHtml = typeof cell === 'string' && cell.includes('<');
            return (
              <td
                class={isNum ? "numeric" : ""}
                set:html={isHtml ? cell : undefined}
              >
                {!isHtml && cell}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
