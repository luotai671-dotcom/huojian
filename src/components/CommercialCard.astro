---
import DataStatusBadge from './DataStatusBadge.astro';

interface Props {
  brandId: string;
  name: string;
  rank?: number;
  isPrimary?: boolean;
  minPayment?: string | number;
  entryPlan?: string;
  lineType?: string | string[];
  protocol?: string | string[];
  registerUrl: string;
  promoCode?: string | null;
  highlights?: string[];
  limitations?: string[];
  vendorClaims?: string[];
  dataStatus?: "vendor" | "measured" | "unverified";
}

const {
  brandId,
  name,
  rank,
  isPrimary = false,
  minPayment,
  entryPlan,
  lineType,
  protocol,
  registerUrl,
  promoCode,
  highlights = [],
  limitations = [],
  vendorClaims = [],
  dataStatus = "measured",
} = Astro.props;

const lineDisplay = Array.isArray(lineType) ? lineType.join(' / ') : lineType;
const protocolDisplay = Array.isArray(protocol) ? protocol.join(' / ') : protocol;
---

<div class={`card my-6 border ${isPrimary ? 'border-blue-500 shadow-md ring-1 ring-blue-500/20' : 'border-slate-200'}`}>
  <!-- Header row -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-100">
    <div class="flex items-center gap-2.5">
      {rank && (
        <span class={`w-6 h-6 rounded-full flex items-center justify-center text-[12px] font-bold ${rank === 1 ? 'bg-amber-400 text-amber-950' : 'bg-slate-100 text-slate-700'}`}>
          {rank}
        </span>
      )}
      <a href={`/airports/${brandId}/`} class="text-[20px] font-bold text-slate-900 hover:text-blue-600 transition-colors">
        {name}
      </a>
      {isPrimary && (
        <span class="px-2 py-0.5 rounded text-[12px] font-bold bg-blue-600 text-white">
          本站主推
        </span>
      )}
      <DataStatusBadge status={dataStatus} />
    </div>

    <div class="text-right">
      <span class="text-[13px] text-slate-500">最低门槛：</span>
      <span class="numeric text-[18px] font-bold text-blue-700">
        {typeof minPayment === 'number' ? `${minPayment} 元/月` : minPayment}
      </span>
    </div>
  </div>

  <!-- Body Content -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4 text-[14px]">
    <div class="space-y-2">
      <div>
        <span class="text-slate-500 font-medium">入门套餐：</span>
        <span class="text-slate-800">{entryPlan || '详见官网说明'}</span>
      </div>
      <div>
        <span class="text-slate-500 font-medium">线路架构：</span>
        <span class="text-slate-800">{lineDisplay || '待核验'}</span>
      </div>
      <div>
        <span class="text-slate-500 font-medium">协议支持：</span>
        <span class="text-slate-800">{protocolDisplay || '待核验'}</span>
      </div>
    </div>

    <!-- Highlights & Limitations -->
    <div class="space-y-1.5">
      {highlights.map((h) => (
        <div class="flex items-start gap-1.5 text-slate-700">
          <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>{h}</span>
        </div>
      ))}
      {limitations.map((l) => (
        <div class="flex items-start gap-1.5 text-slate-500 text-[13px]">
          <span class="text-amber-600 font-bold">!</span>
          <span>{l}</span>
        </div>
      ))}
    </div>
  </div>

  {vendorClaims.length > 0 && (
    <div class="bg-purple-50/60 border border-purple-100 rounded-lg p-2.5 my-3 text-[13px] text-purple-900 space-y-1">
      {vendorClaims.map((c) => (
        <p>• {c.startsWith("品牌资料显示") ? c : `品牌资料显示：${c}`}</p>
      ))}
    </div>
  )}

  <!-- Footer Actions -->
  <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-100 text-[13px]">
    <div class="flex items-center gap-2">
      {promoCode ? (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-amber-50 text-amber-900 border border-amber-200">
          <span>优惠码：</span>
          <strong class="font-mono text-amber-700">{promoCode}</strong>
        </span>
      ) : (
        <span class="text-slate-400">暂无专属折扣码</span>
      )}
      <a href={`/airports/${brandId}/`} class="text-blue-600 hover:underline">
        查看完整档案 →
      </a>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-[12px] text-slate-400 hidden sm:inline">
        含推广链接，不影响用户实付
      </span>
      <a
        href={registerUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class={`px-4 py-2 rounded-lg text-[14px] font-semibold text-white shadow-sm transition-all ${isPrimary ? 'bg-blue-600 hover:bg-blue-700 hover:shadow-md' : 'bg-slate-800 hover:bg-slate-900'}`}
      >
        前往官网注册
      </a>
    </div>
  </div>
</div>
