---
interface Props {
  question: string;
  directAnswer?: string;
  scope?: string;
  evidence?: string;
  action?: string;
}

const { question, directAnswer, scope, evidence, action } = Astro.props;
---

<div class="my-6 p-5 bg-blue-50/70 border-l-4 border-blue-600 rounded-r-xl shadow-sm text-slate-800">
  <div class="flex items-center gap-2 mb-2 text-blue-900 font-bold text-[18px]">
    <svg class="w-5 h-5 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span>结论速览：{question}</span>
  </div>

  {directAnswer && (
    <div class="text-[16px] font-semibold text-slate-900 leading-snug mb-3">
      {directAnswer}
    </div>
  )}

  <div class="space-y-2 text-[15px] text-slate-700 leading-normal">
    <slot />
    {scope && (
      <div>
        <span class="font-medium text-slate-900">适用边界：</span>
        {scope}
      </div>
    )}
    {evidence && (
      <div>
        <span class="font-medium text-slate-900">依据与测试：</span>
        {evidence}
      </div>
    )}
    {action && (
      <div class="pt-1 text-blue-800 font-medium">
        <span>下一步建议：</span>
        {action}
      </div>
    )}
  </div>
</div>
