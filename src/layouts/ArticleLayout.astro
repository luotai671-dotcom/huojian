---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs, { type BreadcrumbItem } from '../components/Breadcrumbs.astro';
import CommercialDisclosure from '../components/CommercialDisclosure.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CardGrid from '../components/CardGrid.astro';
import { getRelatedArticles } from '../lib/related';

interface Props {
  stableId: string;
  title: string;
  description: string;
  breadcrumbs: BreadcrumbItem[];
  publishedAt?: string;
  updatedAt?: string;
  clusterPath?: string;
}

const {
  stableId,
  title,
  description,
  breadcrumbs,
  publishedAt = "2026-10-23",
  updatedAt = "2026-10-23",
} = Astro.props;

const canonicalUrl = `https://xiaohuojianvpn.biz/articles/${stableId}/`;
const relatedArticles = getRelatedArticles(stableId, 4);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "description": description,
  "url": canonicalUrl,
  "inLanguage": "zh-CN",
  "datePublished": publishedAt,
  "dateModified": updatedAt,
  "isAccessibleForFree": true,
  "author": {
    "@type": "Organization",
    "name": "小火箭测评编辑部"
  },
  "publisher": {
    "@type": "Organization",
    "name": "小火箭测评",
    "url": "https://xiaohuojianvpn.biz"
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogType="article"
  schema={articleSchema}
  publishedTime={publishedAt}
  modifiedTime={updatedAt}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- 5-Level Breadcrumb -->
    <Breadcrumbs items={breadcrumbs} />

    <header class="my-6 pb-6 border-b border-slate-200">
      <div class="flex items-center gap-2 text-[12px] text-slate-500 mb-2 font-mono">
        <span class="px-2 py-0.5 rounded bg-slate-100 font-semibold text-slate-700">{stableId}</span>
        <span>•</span>
        <span>发布于 {publishedAt}</span>
        <span>•</span>
        <span>核验于 {updatedAt}</span>
      </div>
      <h1 class="text-[26px] sm:text-[32px] font-extrabold text-slate-900 tracking-tight leading-snug">
        {title}
      </h1>
      <p class="mt-3 text-[16px] text-slate-600 leading-relaxed">
        {description}
      </p>
    </header>

    <CommercialDisclosure />

    <article class="article-content my-8">
      <slot />
    </article>

    <!-- Related Articles Section -->
    {relatedArticles.length > 0 && (
      <section class="mt-12 pt-8 border-t border-slate-200">
        <h2 class="text-[20px] font-bold text-slate-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          <span>延伸与相关阅读</span>
        </h2>
        <CardGrid>
          {relatedArticles.map((item) => (
            <ArticleCard
              title={item.title}
              url={item.url}
              stableId={item.stableId}
              category="相关专题"
            />
          ))}
        </CardGrid>
      </section>
    )}
  </div>
</BaseLayout>
