---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs, { type BreadcrumbItem } from '../components/Breadcrumbs.astro';
import CommercialDisclosure from '../components/CommercialDisclosure.astro';

interface Props {
  title: string;
  h1: string;
  description: string;
  canonicalUrl: string;
  breadcrumbs: BreadcrumbItem[];
  levelName: string;
  wordCount?: string;
}

const {
  title,
  h1,
  description,
  canonicalUrl,
  breadcrumbs,
  levelName,
  wordCount = "3,500+ 字",
} = Astro.props;

const clusterSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": h1,
  "description": description,
  "url": canonicalUrl,
  "inLanguage": "zh-CN"
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={clusterSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <header class="my-6 pb-6 border-b border-slate-200">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-700 font-semibold text-[13px] mb-3">
        <span>{levelName}</span>
        <span>•</span>
        <span>{wordCount}</span>
      </div>
      <h1 class="text-[28px] sm:text-[34px] font-extrabold text-slate-900 tracking-tight leading-tight">
        {h1}
      </h1>
      <p class="mt-3 text-[16px] text-slate-600 leading-relaxed max-w-4xl">
        {description}
      </p>
    </header>

    <CommercialDisclosure />

    <article class="article-content my-8">
      <slot />
    </article>
  </div>
</BaseLayout>
