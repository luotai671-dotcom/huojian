RewriteEngine On

# 1. 强制 HTTPS 传输
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2. 规范顶级裸域名 (消除 www 前缀)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 3. 兼容历史文章路由查询参数 (?post=xxx 或 ?id=xxx) 重定向至标准静态路径
RewriteCond %{QUERY_STRING} (?:^|&)post=([a-zA-Z0-9_-]+) [NC]
RewriteRule ^article(?:\.html)?$ /articles/%1/? [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)id=([a-zA-Z0-9_-]+) [NC]
RewriteRule ^article(?:\.html)?$ /articles/%1/? [R=301,L]

# 4. 兼容 /articles/{id}.html 映射至 /articles/{id}/
RewriteRule ^articles/([a-zA-Z0-9_-]+)\.html$ /articles/$1/ [R=301,L]

# 5. Affiliate 推广链接 302 临时重定向 (严禁使用 301 永久重定向，避免权重外流与客户端缓存)
RewriteRule ^(?:go|aff)/(?:shandian|sds)/?$ https://chenpin.shandianshuaff.com/#/?code=m28TvPVX [R=302,L]
RewriteRule ^(?:go|aff)/(?:liulian|lly)/?$ https://chenpingan.liulianyunaff.com/#/?code=7pdjs9zt [R=302,L]
RewriteRule ^(?:go|aff)/(?:dalao|dalaoyun)/?$ https://chenpin01.dalaoyunaff.com/#/?code=GQ6CL6Km [R=302,L]
RewriteRule ^(?:go|aff)/(?:yunjiexian|yjx)/?$ https://chenpingan.yunjiexianaff.com/#/?code=xLJGaIHM [R=302,L]
RewriteRule ^(?:go|aff)/(?:shenxing|sxjs)/?$ https://chenpingan01.shenxingaff.com/#/?code=RZ48f9wP [R=302,L]
RewriteRule ^(?:go|aff)/(?:huanqiu|hqt)/?$ https://chenpingan01.huanqiutiaff.com/#/?code=FGCcYdFo [R=302,L]
RewriteRule ^(?:go|aff)/(?:jilian|jly)/?$ https://haozevpn.jlyvipaff.com/#/?code=6h2TMD5b [R=302,L]
RewriteRule ^(?:go|aff)/(?:guangnian|gnt)/?$ https://gnt001.gntvipaff.cc/#/?code=rN3ybxa7 [R=302,L]
RewriteRule ^(?:go|aff)/(?:byjd|edgenova)/?$ https://wep.edgenovaaff.com/#/?code=papME7sh [R=302,L]
RewriteRule ^(?:go|aff)/(?:sj|speedworld)/?$ https://pygllc.speedworldaff.cc/#/?code=ll8LjYBJ [R=302,L]
RewriteRule ^(?:go|aff)/(?:kl|kuaili)/?$ https://fanxiaobin.kuailiaff.com/#/?code=sOX6N4Tp [R=302,L]
RewriteRule ^(?:go|aff)/(?:kxy|kosing)/?$ https://everett7623.kosingaff.com//#/?code=Jl6dWU0G [R=302,L]
RewriteRule ^(?:go|aff)/(?:sy|shunyun)/?$ https://ddd.jichang.best/#/register?code=weN73kGq [R=302,L]
RewriteRule ^(?:go|aff)/(?:yt|yuntu)/?$ https://super.ytjcok.org/#/register?code=BKvuyYJI [R=302,L]
RewriteRule ^(?:go|aff)/(?:kpjs|kunpeng)/?$ https://kunpengjiasu.com/#/register?code=oBWoiCcv [R=302,L]

# 5.1 兼容 /go.html?id=xxx 参数重定向至 302 目标推广页
RewriteCond %{QUERY_STRING} (?:^|&)id=(?:shandian|sds)(?:&|$) [NC]
RewriteRule ^go(?:\.html)?$ https://chenpin.shandianshuaff.com/#/?code=m28TvPVX [R=302,L]

